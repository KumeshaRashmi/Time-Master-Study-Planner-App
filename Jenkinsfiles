pipeline {
    agent any 
    
    stages { 
        stage('SCM Checkout') {
            steps {
                retry(3) {
                    git branch: 'main', url: 'https://github.com/KumeshaRashmi/Time-Master-Study-Planner-App'
                }
            }
        }
        stage('Build Docker Image') {
            steps {  
                bat 'docker build -t kumesha rashmi/timemasterimage-cuban::%BUILD_NUMBER% .'
            }
        }
        stage('Login to Docker Hub') {
            steps {
                withCredentials([string(credentialsId: 'r', variable: 'asd')]) {
                    script {
                        bat "docker login -u kumesha rashmi -p %2244689Kum%"
                    }
                }
            }
        }
        stage('Push Image') {
            steps {
                bat 'docker push kumesha rashmi/timemasterimage-cuban::%BUILD_NUMBER%'
            }
        }
    }
    post {
        always {
            bat 'docker logout'
        }
    }
}