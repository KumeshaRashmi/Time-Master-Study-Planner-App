pipeline {
    agent any 
    
    stages { 
        stage('SCM Checkout') {
            steps {
                retry(3) {
                    git branch: 'main', url: 'https://github.com/KumeshaRashmi/Time-Master-Study-Planner-App'
                }
            }
        }
        stage('Build Docker Image') {
            steps {  
                bat 'docker build -t kumesha2244/timemasterimage:%BUILD_NUMBER% .'
            }
        }
        stage('Login to Docker Hub') {
            steps {
                withCredentials([string(credentialsId: 'timemasterpassword', variable: 'timemasterpassword')]) {
                    script {
                        bat "docker login -u kumesha2244 -p %timemasterpassword%"
                    }
                }
            }
        }
        stage('Push Image') {
            steps {
                bat 'docker push kumesha2244/timemasterimage:%BUILD_NUMBER%'
            }
        }
    }
    post {
        always {
            bat 'docker logout'
        }
    }
}