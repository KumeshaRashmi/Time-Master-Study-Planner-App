pipeline {
    agent any

    environment {
        DOCKER_USERNAME = 'kumesha2244'
        DOCKER_IMAGE_FRONTEND = 'kumesha2244/frontend-service'
        DOCKER_IMAGE_BACKEND = 'kumesha2244/backend-service'
        DOCKER_IMAGE_DATABASE = 'kumesha2244/mongo-service'
        BUILD_TAG = 'latest'
    }

    stages {
        stage('SCM Checkout') {
            steps {
                retry(3) {
                    checkout scmGit(
                        branches: [[name: '*/main']],
                        extensions: [],
                        userRemoteConfigs: [[
                            credentialsId: 'githubtoken',
                            url: 'https://github.com/KumeshaRashmi/Time-Master-Study-Planner-App.git'
                        ]]
                    )
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                script {
                    bat '''
                        cd terraform-aws
                        terraform init
                        terraform apply -auto-approve
                    '''
                }
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Build Frontend') {
                    steps {
                        script {
                            bat "docker build -t ${DOCKER_IMAGE_FRONTEND}:${BUILD_TAG} ./frontend"
                        }
                    }
                }
                stage('Build Backend') {
                    steps {
                        script {
                            bat "docker build -t ${DOCKER_IMAGE_BACKEND}:${BUILD_TAG} ./backend"
                        }
                    }
                }
                stage('Pull MongoDB Image') {
                    steps {
                        script {
                            bat "docker pull mongo:6.0"
                            bat "docker tag mongo:6.0 ${DOCKER_IMAGE_DATABASE}:${BUILD_TAG}"
                        }
                    }
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([string(credentialsId: 'timemaster-dockerhubpassword', variable: 'DOCKER_PASSWORD')]) {
                    script {
                        bat "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}"
                    }
                }
            }
        }

        stage('Push Docker Images') {
            parallel {
                stage('Push Frontend Image') {
                    steps {
                        script {
                            bat "docker push ${DOCKER_IMAGE_FRONTEND}:${BUILD_TAG}"
                        }
                    }
                }
                stage('Push Backend Image') {
                    steps {
                        script {
                            bat "docker push ${DOCKER_IMAGE_BACKEND}:${BUILD_TAG}"
                        }
                    }
                }
                stage('Push MongoDB Image') {
                    steps {
                        script {
                            bat "docker push ${DOCKER_IMAGE_DATABASE}:${BUILD_TAG}"
                        }
                    }
                }
            }
        }

        // ✅ Moved inside "stages {}"
        stage('Deploy to EC2') {
            steps {
                script {
                    def ec2_public_ip = bat(script: "cd terraform && terraform output -raw public_ip", returnStdout: true).trim()

                    bat """
                        echo "Connecting to EC2 instance at ${ec2_public_ip}"
                        ssh -o StrictHostKeyChecking=no -i ${SSH_PRIVATE_KEY} ${EC2_USER}@${ec2_public_ip} << EOF
                        docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}

                        docker pull ${DOCKER_IMAGE_FRONTEND}:${BUILD_TAG}
                        docker pull ${DOCKER_IMAGE_BACKEND}:${BUILD_TAG}
                        docker pull ${DOCKER_IMAGE_DATABASE}:${BUILD_TAG}

                        docker network create mern_network || true

                        docker run -d --network mern_network --name mongo -p 27017:27017 ${DOCKER_IMAGE_DATABASE}:${BUILD_TAG}
                        docker run -d --network mern_network --name backend -p 5000:5000 ${DOCKER_IMAGE_BACKEND}:${BUILD_TAG}
                        docker run -d --network mern_network --name frontend -p 5173:5173 ${DOCKER_IMAGE_FRONTEND}:${BUILD_TAG}

                        exit
                        EOF
                    """
                }
            }
        }
    }

    post {
        always {
            bat 'docker logout'
            echo "Logged out from Docker Hub."
            bat 'docker-compose down -v || true'  // Cleanup Docker Compose properly
        }
        failure {
            echo "Pipeline failed. Check logs."
        }
    }
}
