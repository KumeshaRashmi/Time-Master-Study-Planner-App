pipeline {
    agent any

    environment {
        DOCKER_USERNAME = 'kumesha2244'
        DOCKER_IMAGE_FRONTEND = 'kumesha2244/frontend-service'
        DOCKER_IMAGE_BACKEND = 'kumesha2244/backend-service'
        DOCKER_IMAGE_DATABASE = 'kumesha2244/mongo-service'
        BUILD_TAG = 'latest'
    }

    stages {
        stage('SCM Checkout') {
            steps {
                retry(3) {
                    checkout scmGit(
                        branches: [[name: '*/main']],
                        extensions: [],
                        userRemoteConfigs: [[
                            credentialsId: 'githubtoken',
                            url: 'https://github.com/KumeshaRashmi/Time-Master-Study-Planner-App.git'
                        ]]
                    )
                }
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Build Frontend') {
                    steps {
                        script {
                            bat "docker build -t ${DOCKER_IMAGE_FRONTEND}:${BUILD_TAG} ./frontend"
                        }
                    }
                }
                stage('Build Backend') {
                    steps {
                        script {
                            bat "docker build -t ${DOCKER_IMAGE_BACKEND}:${BUILD_TAG} ./backend"
                        }
                    }
                }
                stage('Pull MongoDB Image') {
                    steps {
                        script {
                            bat "docker pull mongo:6.0"
                            bat "docker tag mongo:6.0 ${DOCKER_IMAGE_DATABASE}:${BUILD_TAG}"
                        }
                    }
                }
            }
        }

        // stage('Run Containers for Testing') {
        //     steps {
        //         script {
        //           bat 'docker rm -f mongo_service || exit 0'  // Force remove mongo_service
        //           bat 'docker rm -f backend_service || exit 0' // Force remove backend_service
        //           bat 'docker rm -f frontend_service || exit 0' // Force remove frontend_service
        //           bat 'docker-compose down -v || exit 0'      // Clean up Docker Compose stuff
        //           bat 'docker-compose up -d'                 // Start containers
        //         }
        //     }
        // }

        // stage('Install Dependencies') {
        //     steps {
        //         script {
        //             bat "docker exec -u node backend_service npm ci" // Correct way to install dependencies
        //         }
        //     }
        // }

        // stage('Run Tests') {
        //     steps {
        //         script {
        //             bat "docker exec backend_service npm test"
        //         }
        //     }
        // }
// stage('Login to Docker Hub') {
//             steps {
//             withCredentials([string(credentialsId: 'dockerhub-pass', variable: 'timemaster-dockerhub')]) {
//                     script {
//                         bat "docker login -u kumesha2244 -p %%timemaster-dockerhub%%"
//                     }
//                 }
//         }
//         }
        stage('Login to Docker Hub') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'dockerhub-pass', variable: 'timemaster-dockerhub')]) {
                        def loginCommand = "docker login -u ${DOCKER_USERNAME} -p %%dockerhub-pass%%"
                        bat loginCommand
                    }
                }
            }
        }

        stage('Push Docker Images') {
            parallel {
                stage('Push Frontend Image') {
                    steps {
                        script {
                            bat "docker push ${DOCKER_IMAGE_FRONTEND}:${BUILD_TAG}"
                        }
                    }
                }
                stage('Push Backend Image') {
                    steps {
                        script {
                            bat "docker push ${DOCKER_IMAGE_BACKEND}:${BUILD_TAG}"
                        }
                    }
                }
                stage('Push MongoDB Image') {
                    steps {
                        script {
                            bat "docker push ${DOCKER_IMAGE_DATABASE}:${BUILD_TAG}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            bat 'docker logout'
            echo "Logged out from Docker Hub."
            bat 'docker-compose down -v || true'  // Cleanup Docker Compose properly
        }
        failure {
            echo "Pipeline failed. Check logs."
        }
    }
}
